{
  "name": "lager-melder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "VITE_BACKEND_URL=http://127.0.0.1:8080/api vite --host 0.0.0.0 --port 9000",
    "dev": "npm run start",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "lint:check": "eslint . --max-warnings=0",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "vue": "^3.3.11",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.2.5",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@mdi/font": "^7.3.67",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^23.0.1",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "typescript": "~5.3.0",
    "vite": "^6.4.2",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.1.6"
  }
}
